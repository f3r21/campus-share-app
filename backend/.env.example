# Variables de entorno del backend (copia a .env para desarrollo local).
# NO subas tu archivo .env real al repositorio.

# Cadena de conexión PostgreSQL. En local con Docker:
#   postgres://campus:campus@localhost:5432/campus_share
DATABASE_URL=

# Secreto para firmar los JWT. OBLIGATORIO: el servidor no arranca sin él.
# Genera uno fuerte con: openssl rand -base64 48
JWT_SECRET=

# Puerto del servidor (por defecto 8080).
PORT=8080

# Origen permitido para CORS. Si se omite, se permite cualquier origen.
# En producción, fíjalo a la URL del frontend.
FRONTEND_ORIGIN=

# DigitalOcean Spaces (opcional). Sin estas variables, los archivos se
# guardan localmente y son efímeros en el contenedor.
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET_NAME=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=us-east-1
