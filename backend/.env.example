# Variables de entorno del backend (copia a .env para desarrollo local).
# NO subas tu archivo .env real al repositorio.

# Cadena de conexión PostgreSQL. En local con Docker:
#   postgres://campus:campus@localhost:5432/campus_share
DATABASE_URL=

# Secreto para firmar los JWT. OBLIGATORIO: el servidor no arranca sin él.
# Genera uno fuerte con: openssl rand -base64 48
JWT_SECRET=

# Google Sign-In: Client ID OAuth 2.0 (Web). MISMO valor que VITE_GOOGLE_CLIENT_ID
# del frontend. Sin esta variable, /api/auth/google responde 503.
GOOGLE_CLIENT_ID=

# Puerto del servidor (por defecto 8080).
PORT=8080

# Origen permitido para CORS. Si se omite, se permite cualquier origen.
# En producción, fíjalo a la URL del frontend.
FRONTEND_ORIGIN=

# Almacenamiento de objetos S3-compatible (opcional). Sin estas variables, los
# archivos se guardan localmente y son efímeros en el contenedor.
#
# DigitalOcean Spaces:
#   SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
#   SPACES_REGION=us-east-1
# Cloudflare R2 (también S3-compatible, reutiliza el mismo cliente):
#   SPACES_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   SPACES_REGION=auto
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET_NAME=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=us-east-1

# URL pública base del bucket para construir el enlace de descarga del archivo.
# - DigitalOcean Spaces: déjalo vacío; se usa por defecto
#   https://<SPACES_BUCKET_NAME>.nyc3.digitaloceanspaces.com/<archivo>.
# - Cloudflare R2: fíjalo a la URL pública de tu bucket, p. ej.
#   https://pub-<hash>.r2.dev  o  https://archivos.tudominio.com
# Se le añade '/<nombre-de-archivo>' (las barras finales sobrantes se eliminan).
STORAGE_PUBLIC_URL=

# Sentry (monitoreo de errores, opcional). Si se omite, es un NO-OP: el servidor
# arranca y funciona igual sin enviar nada. Define el DSN de tu proyecto Sentry
# para capturar excepciones no controladas.
SENTRY_DSN=
