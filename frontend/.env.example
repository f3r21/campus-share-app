# Public Google OAuth Web Client ID used by Google Identity Services in the browser.
# This value is embedded in the client bundle at build time (Vite VITE_* prefix),
# so it is public by design — it is an OAuth Client ID, not a secret.
#
# Use the SAME Client ID value the backend uses for GOOGLE_CLIENT_ID, so the
# ID token issued for this client validates server-side at POST /api/auth/google.
#
# Get it from Google Cloud Console > APIs & Services > Credentials >
# OAuth 2.0 Client IDs (type: Web application).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
